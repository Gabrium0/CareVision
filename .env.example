# Copy to .env and fill in. Never commit real secrets.

# --- Voice agent (Moondream Cloud) ---
# `MOONDREAM_API_KEY` is accepted as an alternative variable name.
X-Moondream-Auth=your-moondream-api-key
# Optional model id override (default moondream/moondream3-preview).
MOONDREAM_MODEL=

# --- Voice agent (Google Gemini, free tier) ---
# Only used when --voice-model gemini... is passed; takes no effect otherwise.
GEMINI_API_KEY=

# --- Opt-in Groq speech-to-text ---
# Only used when --groq-stt is passed. Completed speech segments (not silence)
# are sent to Groq Whisper; leave empty to keep microphone processing local.
GROQ_API_KEY=

# --- Opt-in NVIDIA cloud inference ---
# Used for hosted skin/scene screening (only with --enable-cloud-skin and/or
# --enable-cloud-scene) and for the voice agent when --voice-model nvidia:<id>
# is selected. Leaving this unset is fine; nothing is scheduled without both
# the key and the per-run consent flag / model choice.
NVIDIA_API_KEY=

# --- Weather (for clothing/weather advice) ---
# Optional; can also be set under `weather` in config/modules.yaml instead.
WEATHER_LAT=
WEATHER_LON=

# --- Native ML thread pools (advanced, optional) ---
# Set to 1 only if you are intentionally supplying your own OMP_NUM_THREADS /
# MKL_NUM_THREADS / TORCH_NUM_THREADS etc. before launch; otherwise the app
# sets conservative defaults itself so OpenCV/TF/Torch/JAX workers cannot
# starve MediaPipe or the vitals sampler.
APP_RESPECT_NATIVE_THREAD_ENV=

# --- iPad camera over WebRTC (--source ipad) ---
# RELAY_SECRET is required: the shared HMAC secret for the signaling relay
# (same value as RELAY_SECRET on the relay service). It only ever comes from
# .env, never a command line. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_SECRET=
# Defaults for --ipad-relay-url / --ipad-room; both flags override these per run.
# A quick-tunnel trycloudflare.com URL changes on every cloudflared restart.
IPAD_RELAY_URL=
IPAD_ROOM=
# Optional: pin the 6-digit pairing code instead of a fresh random one per run.
IPAD_PAIR_CODE=
# Silent lead (seconds) before the agent's first word on the iPad audio route.
# The iPad releases its mic when the agent speaks so iOS can switch output to a
# Bluetooth (A2DP) speaker; that switch takes ~0.5-2s, and this pad keeps the
# opening from being clipped or briefly played on the built-in speaker. 0 = off.
IPAD_AUDIO_LEAD_SECONDS=0.7

# --- Caregiver alert channels (each is optional; missing ones are skipped) ---
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Webhook (Slack/Discord/custom)
ALERT_WEBHOOK_URL=

# SMS (Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
ALERT_SMS_TO=
