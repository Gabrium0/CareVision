# Copy to .env and fill in. Never commit real secrets.

# --- Voice agent (Moondream Cloud) ---
# `MOONDREAM_API_KEY` is accepted as an alternative variable name.
X-Moondream-Auth=your-moondream-api-key

# --- Caregiver alert channels (each is optional; missing ones are skipped) ---
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Webhook (Slack/Discord/custom)
ALERT_WEBHOOK_URL=

# SMS (Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
ALERT_SMS_TO=
