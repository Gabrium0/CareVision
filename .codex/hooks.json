{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.agents/skills/graphify/scripts/graphify.mjs\" hook",
            "commandWindows": "powershell -NoProfile -Command \"node (Join-Path (git rev-parse --show-toplevel) '.agents/skills/graphify/scripts/graphify.mjs') hook\"",
            "statusMessage": "Loading the repository Graphify integration"
          }
        ]
      }
    ]
  }
}
